# Publieke Mapbox-token (pk.…) voor de werkgebied-kaart op /contact.
# Aanmaken via https://account.mapbox.com/access-tokens/
# Kopieer dit bestand naar .env.local en vul de token in.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Mailverzending voor het offerteformulier (app/api/offerte) via
# Strato-SMTP. De site draait op een eigen VPS, dus een directe
# SMTP-verbinding werkt prima. Versturen via Strato zorgt er ook
# voor dat SPF/DMARC van het domein kloppen.
#
#   SMTP_USER  = volledig e-mailadres van de Strato-mailbox
#   SMTP_PASS  = wachtwoord van die mailbox (Strato-klantenlogin)
#   SMTP_HOST  = optioneel, standaard smtp.strato.com
#   SMTP_PORT  = optioneel, standaard 465 (SSL/TLS)
#   MAIL_FROM  = optioneel, standaard "Bouw MAN website" <SMTP_USER>
#                (moet een adres op het eigen domein zijn, anders
#                 weigert Strato de mail)
SMTP_USER=info@bouwmantegelwerk.nl
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
MAIL_FROM=

# Toekomstige advertentie-scripts (Google Ads / Meta Pixel) — zie
# components/MarketingScripts.tsx. Laat leeg zolang er nog niet
# geadverteerd wordt. Zodra je een ID invult, laadt het bijbehorende
# script automatisch — maar ALLEEN bij bezoekers die in de
# cookiemelding voor "Marketing" hebben gekozen.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18443378044
NEXT_PUBLIC_META_PIXEL_ID=
